<?xml version="1.0" encoding="utf-8"?>
<!-- The 1×1 widget: the whole cell is one tile with today's allowance as big as it
     fits, "/day" under it. Nothing else. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/spending_widget_tile"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/per_day"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="72sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="–"
        android:textColor="#FFA09F97"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="/day"
        android:textColor="#FFA09F97"
        android:textSize="12sp" />
</LinearLayout>
